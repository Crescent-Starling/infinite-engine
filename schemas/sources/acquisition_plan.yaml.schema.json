{
  "$defs": {
    "AcquisitionItem": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/Pin"
        },
        "action": {
          "enum": [
            "metadata_only",
            "request_access",
            "use_local",
            "download"
          ],
          "title": "Action",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "permission_evidence": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permission Evidence"
        }
      },
      "required": [
        "document",
        "action",
        "rationale"
      ],
      "title": "AcquisitionItem",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[a-z_]+_[0-9a-f-]{36}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minimum": 1,
          "title": "Source Version",
          "type": "integer"
        },
        "anchor": {
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "anchor"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "Pin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z_]+_[0-9a-f-]{36}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Pin",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "human",
            "ai",
            "taxonomy_import",
            "test_fixture"
          ],
          "title": "Origin",
          "type": "string"
        },
        "actor": {
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "generator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator"
        },
        "input_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Hash"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "unsupported_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupported Reason"
        }
      },
      "required": [
        "origin",
        "actor",
        "rationale"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1,
      "default": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "profile_revision": {
      "minimum": 1,
      "title": "Profile Revision",
      "type": "integer"
    },
    "state": {
      "const": "proposed",
      "default": "proposed",
      "title": "State",
      "type": "string"
    },
    "max_bytes": {
      "default": 1000000,
      "maximum": 100000000,
      "minimum": 1,
      "title": "Max Bytes",
      "type": "integer"
    },
    "max_requests": {
      "default": 0,
      "maximum": 100,
      "minimum": 0,
      "title": "Max Requests",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/AcquisitionItem"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "plan_id",
    "revision",
    "profile_id",
    "profile_revision",
    "items",
    "provenance"
  ],
  "title": "AcquisitionPlan",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
